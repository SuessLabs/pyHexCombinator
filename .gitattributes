# Auto detect text files and normalize to LF in the repository
* text=auto

# Explicitly declare text files that should always be normalized
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.s text eol=lf
*.txt text eol=lf
*.ioc text eol=lf
*.ld text eol=lf
*.md text eol=lf
*.json text eol=lf
*.code-snippets text eol=lf
*.py text eol=lf
CMakeLists.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Explicitly ensure Windows batch files use CRLF on checkout (if needed)
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Ensure configuration files are handled correctly
.vscode/* text eol=lf
.settings/* text eol=lf
